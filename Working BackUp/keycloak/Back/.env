# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=traceflow_db

# SSL (for production HTTPS)
SSL_KEY_PATH=/etc/ssl/private/key.pem
SSL_CERT_PATH=/etc/ssl/certs/cert.pem

# Frontend (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Token Lifespans (in milliseconds)
ACCESS_TOKEN_MAX_AGE=900000 # 15 minutes, matches Keycloak Access Token Lifespan
REFRESH_TOKEN_MAX_AGE=86400000 # 1 day, cookie retention; actual refresh token validity is governed by Keycloak SSO Session Max
SSO_SESSION_MAX=86400000 # 1 day, matches Keycloak SSO Session Max
SSO_SESSION_IDLE=32400000 # 9 hours, matches Keycloak SSO Session Idle

# Rate Limiting (in milliseconds and max requests)
SENSITIVE_LIMITER_WINDOW_MS=600000 # 10 minutes
SENSITIVE_LIMITER_MAX=15
OTP_LIMITER_WINDOW_MS=600000 # 10 minutes
OTP_LIMITER_MAX=5
REFRESH_LIMITER_WINDOW_MS=3600000 # 1 hour
REFRESH_LIMITER_MAX=10

# Node Environment
NODE_ENV=development #production

# API Timeout (in milliseconds)
API_TIMEOUT=30000

